OPENAI_API_KEY=replace-with-your-key
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
RAG_BACKEND=local
SERVICE_VERSION=1.0.0
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=manufacturing-maintenance-rag-api
MLFLOW_TRACKING_ENABLED=true
# Optional for local development; provision.sh generates a token for the Azure API.
API_AUTH_TOKEN=

# Azure lab: set RAG_BACKEND=azure. Use deployment names, not base model IDs.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=rag-chat
AZURE_OPENAI_EMBED_DEPLOYMENT=rag-embed
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_ADMIN_KEY=
# A query-only key can be supplied to the runtime; ingestion still needs the admin key.
AZURE_SEARCH_QUERY_KEY=
AZURE_SEARCH_INDEX=maintenance-rag
EMBED_DIM=1536
