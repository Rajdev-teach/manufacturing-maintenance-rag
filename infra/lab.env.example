# Non-secret provisioning choices. Export these in Bash or Azure Cloud Shell.
export AZURE_SUBSCRIPTION_ID=replace-with-your-subscription-id
export AZURE_RESOURCE_GROUP=rajdev-rag-lab-rg
export AZURE_LOCATION=eastus2
export AZURE_OWNER=Rajdev-teach
export AZURE_COST_CENTER=learning
export AZURE_BASE_NAME=maint
export AZURE_CHAT_MODEL=gpt-4o-mini
export AZURE_CHAT_MODEL_VERSION=2024-07-18
export AZURE_EMBED_MODEL=text-embedding-3-small
export AZURE_EMBED_MODEL_VERSION=1
export AZURE_MODEL_SKU=Standard
export AZURE_MODEL_CAPACITY=1
export AZURE_LAB_PYTHON=.venv/bin/python
export GITHUB_REPOSITORY=Rajdev-teach/manufacturing-maintenance-rag
